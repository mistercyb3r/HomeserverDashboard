# Persistent config directory (mounted as /data in Docker)
DATA_DIR=./data

# Display name shown in the dashboard header
SERVER_NAME=Home Server

# Host port published by Docker (container still listens on 8080)
# Default 8787 — change if needed. Do not use 8080 if StarPulse already owns it.
DASHBOARD_PORT=8787

# Host filesystem bind inside the container (see docker-compose hostfs mount)
HOST_FS_ROOT=/hostfs

# Optional remapped sysfs root for temperatures (default /sys)
# HOST_SYS_ROOT=/sys

# Jellyfin (optional) — API key stays server-side and is never exposed by the API
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# StarPulse — also used as the Starlink telemetry source
STARPULSE_URL=http://starpulse:8000

# Portainer (optional) — opens in a new browser tab
PORTAINER_URL=

# Docker Engine socket (mounted into the container by docker-compose)
DOCKER_SOCKET=/var/run/docker.sock

# Weather (Open-Meteo, no API key). Does not affect system health.
WEATHER_ENABLED=true
WEATHER_LOCATION=Thetford, Norfolk, UK
# Optional fixed coordinates skip geocoding:
# WEATHER_LATITUDE=52.413
# WEATHER_LONGITUDE=0.751
WEATHER_CACHE_SECONDS=600
